{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "endOfLine": "lf",
  "useTabs": false,
  "trailingComma": "none",
  "printWidth": 100,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app.css",
    "functions": ["clsx", "cn", "cva", "tv"]
  },
  "svelte": {},
  "ignorePatterns": [
    "node_modules",
    "build",
    "dist",
    ".svelte-kit",
    ".vercel",
    "pnpm-lock.yaml",
    "bun.lock",
    "src/lib/components/ui"
  ]
}
