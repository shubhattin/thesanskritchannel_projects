{
  "singleQuote": true,
  "semi": true,
  "endOfLine": "lf",
  "useTabs": false,
  "trailingComma": "none",
  "printWidth": 100,
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    }
  ],
  "tailwindStylesheet": "./src/styles/global.css",
  "tailwindFunctions": ["clsx", "cn", "cva", "tv"]
}
