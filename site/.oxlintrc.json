{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "build",
    ".astro",
    ".svelte-kit",
    ".vercel",
    "src/components/Posthog.astro",
    "src/lib/components/ui"
  ]
}
