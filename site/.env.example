# Local `vite dev` only. Copy to `.env` — never commit real values.
# Production runtime: Cloudflare dashboard → Settings → Variables and Secrets.
# Production build-time (VITE_* / PUBLIC_*): dashboard → Settings → Build → Build variables.

PG_DATABASE_URL="postgresql://username:password@host:port/database"
# Optional DB_MODE variants if you use resolveDbUrl switching:
# DB_MODE="PROD"
# PG_DATABASE_URL1="postgresql://..."
# PG_DATABASE_URL2="postgresql://..."
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"
# Remote Better Auth API base (admin app) — used server-side for session/auth fetches
VITE_BETTER_AUTH_URL="http://localhost:your-port"

# Posthog (frontend-only; not used by Effect runtime)
PUBLIC_POSTHOG_KEY="example-public-posthog-key"
PUBLIC_POSTHOG_URL="https://us.i.posthog.com"
