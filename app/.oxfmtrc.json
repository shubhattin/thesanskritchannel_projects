{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "endOfLine": "lf",
  "useTabs": false,
  "trailingComma": "none",
  "printWidth": 100,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app.css"
  },
  "svelte": {},
  "ignorePatterns": [
    "node_modules",
    "build",
    ".netlify",
    ".vercel",
    ".svelte-kit",
    ".venv",
    ".trigger",
    "pnpm-lock.yaml",
    "bun.lock",
    "src/db/migrations",
    "src/db/scripts/out/",
    "src/db/scripts/backup/",
    "kAraH",
    "src/tools/converter/resources",
    "src/api/routes/grammer/grammer_prompt.md"
  ]
}
