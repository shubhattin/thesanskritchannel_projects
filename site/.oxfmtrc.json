{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "endOfLine": "lf",
  "useTabs": false,
  "trailingComma": "none",
  "printWidth": 100,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/global.css"
  },
  "svelte": {},
  "ignorePatterns": [
    "node_modules",
    "build",
    "dist",
    ".astro",
    ".svelte-kit",
    ".vercel",
    "pnpm-lock.yaml",
    "bun.lock",
    "src/components/Posthog.astro",
    "**/*.astro",
    "src/lib/components/ui"
  ]
}
