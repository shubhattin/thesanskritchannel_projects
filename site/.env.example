# Site Worker runtime + build env (Cloudflare).
# Local: copy to `.env` / `.dev.vars` as needed. Production: GitHub Actions secrets
# (see `.github/workflows/deploy_site.yml`) — not the Cloudflare Build panel.

# --- Runtime secrets (wrangler secret bulk from CI) ---
PG_DATABASE_URL="postgresql://username:password@host:port/database"
# Optional DB_MODE variants if you use resolveDbUrl switching:
# DB_MODE="PROD"
# PG_DATABASE_URL1="postgresql://..."
# PG_DATABASE_URL2="postgresql://..."
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"
# Remote Better Auth API base (admin app) — used server-side for session/auth fetches
VITE_BETTER_AUTH_URL="http://localhost:your-port"

# --- Build-time public (client bundle; set in CI build env) ---
PUBLIC_POSTHOG_KEY="example-public-posthog-key"
PUBLIC_POSTHOG_URL="https://us.i.posthog.com"
